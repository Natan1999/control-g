{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/marketing.mjs": {
      "maxDuration": 60,
      "includeFiles": "{.server/**,dist/marketing-shell.html,dist/seo-blog-snapshot.json}"
    },
    "api/**/*.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/maintenance/snapshots",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/maintenance/arcgis",
      "schedule": "35 3 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(self), geolocation=(self), microphone=(self)",
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://www.controlg.co https://controlg2.dran.cloud wss://controlg2.dran.cloud https://geoportal.dane.gov.co https://api-colombia.com https://*.arcgis.com https://*.arcgisonline.com https://*.esri.com https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "^/api/health$",
      "headers": {
        "Cache-Control": "no-store, max-age=0",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      },
      "continue": true
    },
    {
      "src": "^/(login|recuperar-contrasena|restablecer-contrasena|admin|coord|apoyo|field)(?:/.*)?$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      },
      "continue": true
    },
    {
      "src": "^/(recuperar-contrasena|restablecer-contrasena|index\\.html|sw\\.js|seo-manifest\\.json)$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Vercel-CDN-Cache-Control": "no-store",
        "Pragma": "no-cache",
        "Expires": "0"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/manifest\\.webmanifest$",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "^/demo/?$",
      "headers": {
        "Location": "/login"
      },
      "status": 307
    },
    {
      "src": "^/blog/index\\.html$",
      "headers": {
        "Location": "/blog"
      },
      "status": 308
    },
    {
      "src": "^/blog/([a-z0-9]+(?:-[a-z0-9]+)*)/index\\.html$",
      "headers": {
        "Location": "/blog/$1"
      },
      "status": 308
    },
    {
      "src": "^/(sitemap\\.xml|rss\\.xml|llms(?:-full)?\\.txt|blog-catalog\\.json)$",
      "dest": "/api/marketing?path=/$1"
    },
    {
      "src": "^/blog/?$",
      "dest": "/api/marketing?path=/blog"
    },
    {
      "src": "^/blog/([a-z0-9]+(?:-[a-z0-9]+)*)/?$",
      "dest": "/api/marketing?path=/blog/$1"
    },
    {
      "src": "^/(software-caracterizacion-social|encuestas-offline|levantamiento-informacion-campo|software-entidades-gobierno|encuestas-con-inteligencia-artificial|encuestas-georreferenciadas|integracion-arcgis|encuestas-para-empresas|encuestas-para-ong|caracterizacion-colombia)/?$",
      "dest": "/$1/index.html"
    },
    {
      "src": "^/encuestas-offline/(argentina|bolivia|brasil|chile|colombia|costa-rica|cuba|republica-dominicana|ecuador|el-salvador|guatemala|honduras|mexico|nicaragua|panama|paraguay|peru|puerto-rico|uruguay|venezuela)/?$",
      "dest": "/encuestas-offline/$1/index.html"
    },
    {
      "src": "^/(marketing-shell\\.html|seo-blog-snapshot\\.json)$",
      "dest": "/404.html",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, follow, noarchive"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(login|recuperar-contrasena|restablecer-contrasena|admin|coord|apoyo|field)(?:/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, follow, noarchive"
      }
    }
  ]
}
