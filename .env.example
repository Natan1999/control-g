# Variables públicas incluidas en la aplicación web/APK
VITE_SUPABASE_URL=https://tu-supabase.example.com
VITE_SUPABASE_ANON_KEY=tu-clave-anonima
# Opcional: exige MFA también al superadministrador global. Cada entidad
# administra su política con require_mfa_for_privileged.
VITE_REQUIRE_ADMIN_MFA=false
VITE_CONTROL_G_API_URL=https://www.controlg.co

# Solo en el servidor de Vercel, nunca con prefijo VITE_:
# ARCGIS_ENTIDAD_CLIENT_SECRET=<client-secret-oauth>

# Solo para scripts administrativos. Nunca usar VITE_ ni incluir en el APK.
SUPABASE_URL=https://tu-supabase.example.com
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
CONTROL_G_INITIAL_PASSWORD=define-una-clave-temporal-segura
CONTROL_G_ENTITY_ID=gov-bolivar-2026
CONTROL_G_TEST_EMAIL=admin@tu-organizacion.com
CONTROL_G_TEST_PASSWORD=clave-temporal-del-administrador

# Correos iniciales opcionales
CONTROL_G_ADMIN_EMAIL=admin@tu-organizacion.com
CONTROL_G_COORDINATOR_EMAIL=coordinacion@tu-organizacion.com
CONTROL_G_SUPPORT_EMAIL=apoyo@tu-organizacion.com
CONTROL_G_PROFESSIONAL_EMAIL=campo@tu-organizacion.com
